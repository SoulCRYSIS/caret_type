# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app.
# Leave these empty to run in offline guest mode (no sign-in, no standings).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to talk to the local Auth (9099) and Firestore (8080) emulators.
# Works without the values above (a demo project id is used).
VITE_USE_EMULATORS=false
